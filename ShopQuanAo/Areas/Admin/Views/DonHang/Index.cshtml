@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<ShopQuanAo.Models.DonHang>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0 text-primary"><i class="fas fa-clipboard-list me-2"></i>Quản Lý Đơn Hàng</h4>
        <div class="text-muted small mt-1">Theo dõi, cập nhật trạng thái và xử lý giao dịch hệ thống.</div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" 
                           class="form-control bg-light border-0" placeholder="Nhập mã đơn hàng (#123) hoặc tên, SĐT khách hàng...">
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">Tìm đơn</button>
            </div>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4 rounded-3 alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4 rounded-3 alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="main-card card border-0 mb-5 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="border-0 ps-4">Mã ĐH</th>
                        <th class="border-0">Ngày Đặt</th>
                        <th class="border-0">Khách Hàng</th>
                        <th class="border-0 text-end">Tổng Tiền</th>
                        <th class="border-0 text-center">Trạng Thái & Thanh Toán</th>
                        <th class="border-0 text-center pe-4" style="min-width: 180px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">#@item.MaDH</td>
                                <td>
                                    <div class="text-dark">@item.NgayDat.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@item.NgayDat.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-primary">@item.TenNguoiNhan</div>
                                    <div class="text-muted small">@item.SDTNguoiNhan</div>
                                </td>
                                <td class="text-end fw-bold text-danger">
                                    @item.TongTien.ToString("#,##0") đ
                                </td>
                                <td class="text-center">
                                    <!-- 1. Trạng Thái Đơn Hàng -->
                                    <div class="mb-1">
                                        @if (item.TrangThaiDH == 0 || item.TrangThaiDH == 1) {
                                            <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1">Chờ duyệt</span>
                                        } else if (item.TrangThaiDH == 2) {
                                            <span class="badge rounded-pill bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-1">Đang giao</span>
                                        } else if (item.TrangThaiDH == 3) {
                                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1">Thành công</span>
                                        } else {
                                            <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-1">Đã hủy</span>
                                        }
                                    </div>
                                    
                                    <!-- 2. Trạng Thái Thanh Toán (VNPAY / COD) -->
                                    <div>
                                        @if (item.GiaoDichThanhToans != null && item.GiaoDichThanhToans.Any(g => g.TrangThaiGiaoDich == 1))
                                        {
                                            var vnPayGD = item.GiaoDichThanhToans.First(g => g.TrangThaiGiaoDich == 1);
                                            <span class="badge bg-success shadow-sm" data-bs-toggle="tooltip" title="Mã GD: @vnPayGD.MaGiaoDichDoiTac">
                                                <i class="fas fa-check-circle me-1"></i> Đã thanh toán (VNPay)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border shadow-sm">
                                                <i class="fas fa-truck me-1"></i> Nhận hàng trả tiền (COD)
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Details" asp-route-id="@item.MaDH" class="btn btn-sm btn-light border text-primary" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                                        <a asp-action="InHoaDon" asp-route-id="@item.MaDH" target="_blank" class="btn btn-sm btn-light border text-dark" title="In"><i class="fas fa-print"></i></a>
                                        
                                        @if (item.TrangThaiDH == 1) 
                                        {
                                            <form asp-action="XacNhan" asp-route-id="@item.MaDH" method="post" class="d-inline" onsubmit="return confirm('Duyệt đơn này?')">
                                                <button type="submit" class="btn btn-sm btn-light border text-info" title="Xác nhận giao hàng"><i class="fas fa-check"></i></button>
                                            </form>
                                            <form asp-action="HuyDon" asp-route-id="@item.MaDH" method="post" class="d-inline" onsubmit="return confirm('Hủy đơn hàng này?')">
                                                <button type="submit" class="btn btn-sm btn-light border text-danger" title="Hủy đơn"><i class="fas fa-times"></i></button>
                                            </form>
                                        }
                                        else if (item.TrangThaiDH == 2) 
                                        {
                                            <form asp-action="HoanThanh" asp-route-id="@item.MaDH" method="post" class="d-inline" onsubmit="return confirm('Xác nhận đã giao thành công?')">
                                                <button type="submit" class="btn btn-sm btn-light border text-success" title="Giao thành công"><i class="fas fa-check-double"></i></button>
                                            </form>
                                            <form asp-action="HuyDon" asp-route-id="@item.MaDH" method="post" class="d-inline" onsubmit="return confirm('Khách không nhận hàng? Hủy đơn?')">
                                                <button type="submit" class="btn btn-sm btn-light border text-danger" title="Hủy đơn (Khách bom)"><i class="fas fa-ban"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open fa-3x mb-3"></i>
                                <h5>Không tìm thấy đơn hàng nào</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model != null && Model.PageCount > 1)
    {
        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center py-3 px-4">
            <div class="text-muted small">
                Trang <strong>@Model.PageNumber</strong> / @Model.PageCount (Tổng @Model.TotalItemCount đơn hàng)
            </div>
            <div>
                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchKeyword = ViewBag.SearchKeyword }), 
                    new X.PagedList.Mvc.Core.PagedListRenderOptions {
                        LiElementClasses = new string[] { "page-item" },
                        PageClasses = new string[] { "page-link", "rounded-circle", "mx-1", "border-0", "shadow-sm" }
                    })
            </div>
        </div>
    }
</div>

<style>
    .pagination { margin-bottom: 0; }
    .page-item.active .page-link { background-color: #3f6ad8 !important; color: white !important; border: none !important; }
    .page-link { color: #495057; transition: all 0.2s; }
    .page-link:hover { background-color: #e0f3ff; color: #3f6ad8; }
</style>

@section Scripts {
    <script>
        // Khởi tạo tooltip để khi rê chuột vào nút sẽ hiện chữ tiếng Việt        
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title], [data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}